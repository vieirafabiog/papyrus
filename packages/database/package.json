{
  "name": "@docuflow/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run test",
    "db:generate": "tsc -p tsconfig.json && drizzle-kit generate",
    "db:migrate": "node dist/migrate-cli.js"
  },
  "dependencies": {
    "@docuflow/domain": "workspace:*",
    "@docuflow/notifications": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.14.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.18.0",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.6"
  }
}
