{
  "name": "docuflow",
  "version": "1.0.0-rc.1",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --passWithNoTests",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:operations": "vitest run --root tests/operations",
    "test:performance": "./apps/api/node_modules/.bin/tsx tests/performance/run-load-test.ts",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "audit:deps": "node scripts/ci/check-dependencies.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@docuflow/auth": "workspace:*",
    "@docuflow/contracts": "workspace:*",
    "@docuflow/database": "workspace:*",
    "@docuflow/domain": "workspace:*",
    "@docuflow/file-processing": "workspace:*",
    "@docuflow/storage-core": "workspace:*",
    "@docuflow/storage-local": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@testcontainers/postgresql": "^10.18.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "pg": "^8.14.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
