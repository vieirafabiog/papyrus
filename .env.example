# ==============================================================================
# papyrus — Variáveis de Ambiente (Exemplo)
# Copie este arquivo para .env e preencha com valores reais em cada ambiente.
# NUNCA versione o arquivo .env nem credenciais reais.
# ==============================================================================

# Ambiente de execução e versão de release fixada
NODE_ENV=development
PAPYRUS_IMAGE_TAG=1.0.0-rc.1

# URL pública da aplicação
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://papyrus:replace_with_db_password@localhost:5432/papyrus

# Segredos de sessão e criptografia (gerar com: openssl rand -hex 32)
SESSION_SECRET=replace_with_at_least_32_bytes_random_hex_string
ENCRYPTION_KEY=replace_with_32_bytes_base64_or_hex_master_key

# Armazenamento e limites de upload
STORAGE_DEFAULT_CONNECTION=local-default
STORAGE_LOCAL_ROOT=./data/storage
UPLOAD_MAX_BYTES=52428800
PROXY_MAX_BODY_BYTES=54525952
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.gif,.tif,.tiff,.txt,.csv,.docx,.xlsx,.pptx

# E-mail (SMTP)
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.invalid
SMTP_PASS=replace_with_smtp_password
SMTP_FROM="papyrus <noreply@example.invalid>"

# Observabilidade local
LOG_LEVEL=info
LOG_PRETTY=false
TELEMETRY_ENABLED=false
